# Netlify Redirects - PRODUCTION READY
/*    /index.html    200

# Cache Headers
/*  !(.js|.css|.png|.jpg|.svg|.webp)
  Cache-Control: public, max-age=0, must-revalidate

*.js    !(.js)
  Cache-Control: public, max-age=31536000, immutable

*.css    !(.css)
  Cache-Control: public, max-age=31536000, immutable

/images/*  !(.png|.jpg|.webp)
  Cache-Control: public, max-age=31536000, immutable